#!/bin/bash
set -euo pipefail

log_file="/var/log/jenkins-setup.log"

log_message() {
  echo "[$(date +'%Y-%m-%d %H:%M:%S')] $*" | tee -a "$log_file" 2>&1 || true
}

error_exit() {
  log_message "ERROR: $*"
  exit 1
}

log_message "Starting Jenkins installation..."

# Update package lists
log_message "Updating package lists..."
apt-get update || error_exit "Failed to update packages"

# Install Java
log_message "Installing Java 17..."
apt-get install -y openjdk-17-jdk || error_exit "Failed to install Java"

# Verify Java installation
java -version >> "$log_file" 2>&1

# Add Jenkins repository
log_message "Adding Jenkins repository..."
mkdir -p /usr/share/keyrings
curl -fsSL https://pkg.jenkins.io/debian-stable/jenkins.io-2023.key | gpg --dearmor -o /usr/share/keyrings/jenkins-keyring.gpg
echo "deb [signed-by=/usr/share/keyrings/jenkins-keyring.gpg] https://pkg.jenkins.io/debian-stable binary/" | tee /etc/apt/sources.list.d/jenkins.list > /dev/null

# Update package lists again
log_message "Updating package lists with Jenkins repo..."
apt-get update || error_exit "Failed to update packages with Jenkins repo"

# Install Jenkins
log_message "Installing Jenkins..."
apt-get install -y jenkins || error_exit "Failed to install Jenkins"

# Start and enable Jenkins
log_message "Starting Jenkins service..."
systemctl daemon-reload
systemctl start jenkins || error_exit "Failed to start Jenkins service"
systemctl enable jenkins || error_exit "Failed to enable Jenkins service"

# Wait for Jenkins to be ready
log_message "Waiting for Jenkins to initialize..."
max_attempts=60
attempt=0
while [ $attempt -lt $max_attempts ]; do
  if systemctl is-active --quiet jenkins; then
    log_message "Jenkins service is active"
    break
  fi
  attempt=$((attempt + 1))
  if [ $((attempt % 10)) -eq 0 ]; then
    log_message "Still waiting... (attempt $attempt/$max_attempts)"
  fi
  sleep 2
done

if [ $attempt -eq $max_attempts ]; then
  log_message "WARNING: Jenkins startup timeout"
  systemctl status jenkins >> "$log_file" 2>&1 || true
  error_exit "Jenkins failed to start"
fi

# Verify Jenkins is listening
log_message "Verifying Jenkins is listening on port 8080..."
sleep 5
if netstat -tuln 2>/dev/null | grep -q ":8080 " || ss -tuln 2>/dev/null | grep -q ":8080 "; then
  log_message "Jenkins is listening on port 8080"
else
  log_message "WARNING: Jenkins not listening on port 8080 yet"
fi

log_message "Jenkins installation completed"

# Install additional tools
log_message "Installing Git..."
apt-get install -y git || log_message "WARNING: Failed to install Git"

log_message "Installing Terraform..."
apt-get install -y curl gpg lsb-release
curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/hashicorp.list
apt-get update
apt-get install -y terraform || log_message "WARNING: Failed to install Terraform"

log_message "Installing AWS CLI..."
curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
unzip -q awscliv2.zip
./aws/install || log_message "WARNING: Failed to install AWS CLI"

log_message "Installing Maven..."
apt-get install -y maven || log_message "WARNING: Failed to install Maven"

log_message "Installing Docker..."
apt-get install -y docker.io || log_message "WARNING: Failed to install Docker"
systemctl start docker || true
systemctl enable docker || true

log_message "All installations completed successfully"
#!/bin/bash
set -euo pipefail

log_file="/var/log/jenkins-setup.log"

log_message() {
  echo "[$(date +'%Y-%m-%d %H:%M:%S')] $*" | tee -a "$log_file" 2>&1 || true
}

error_exit() {
  log_message "ERROR: $*"
  exit 1
}

log_message "Starting Jenkins Docker installation..."

# Update package lists
log_message "Updating package lists..."
apt-get update || error_exit "Failed to update packages"

# Install Docker
log_message "Installing Docker..."
apt-get install -y docker.io || error_exit "Failed to install Docker"

# Start Docker service
log_message "Starting Docker service..."
systemctl start docker || error_exit "Failed to start Docker"
systemctl enable docker || error_exit "Failed to enable Docker"

# Verify Docker installation
log_message "Verifying Docker installation..."
docker --version >> "$log_file" 2>&1

# Create Jenkins directory for volumes
log_message "Creating Jenkins directories..."
mkdir -p /var/lib/jenkins
mkdir -p /var/lib/jenkins/plugins
mkdir -p /var/lib/jenkins_home

# Set permissions
chmod -R 777 /var/lib/jenkins_home

# Create docker-compose.yml for Jenkins
log_message "Creating docker-compose configuration..."
cat > /tmp/docker-compose.yml << 'EOF'
version: '3.8'
services:
  jenkins:
    image: jenkins/jenkins:latest
    container_name: jenkins
    ports:
      - "8080:8080"
      - "50000:50000"
    volumes:
      - /var/lib/jenkins_home:/var/jenkins_home
      - /var/run/docker.sock:/var/run/docker.sock
      - /usr/bin/docker:/usr/bin/docker
    environment:
      - JAVA_OPTS=-Xmx2048m
      - JENKINS_OPTS=--argumentsRealm.passwd.admin=admin --argumentsRealm.roles.admin=admin
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
EOF

# Run Jenkins via docker-compose
log_message "Starting Jenkins container..."
cd /tmp
docker-compose up -d || error_exit "Failed to start Jenkins container"

log_message "Jenkins container started successfully"

# Wait for Jenkins to be ready
log_message "Waiting for Jenkins to initialize..."
max_attempts=60
attempt=0
while [ $attempt -lt $max_attempts ]; do
  if docker exec jenkins curl -s http://localhost:8080 > /dev/null 2>&1; then
    log_message "Jenkins is responding"
    break
  fi
  attempt=$((attempt + 1))
  if [ $((attempt % 10)) -eq 0 ]; then
    log_message "Still waiting... (attempt $attempt/$max_attempts)"
  fi
  sleep 2
done

if [ $attempt -eq $max_attempts ]; then
  log_message "WARNING: Jenkins startup timeout"
  docker logs jenkins >> "$log_file" 2>&1 || true
  error_exit "Jenkins failed to start"
fi

log_message "Jenkins is ready and running!"

# Get initial admin password
if [ -f /var/lib/jenkins_home/secrets/initialAdminPassword ]; then
  JENKINS_PASSWORD=$(cat /var/lib/jenkins_home/secrets/initialAdminPassword)
  log_message "Jenkins initial admin password retrieved"
  echo "JENKINS_INITIAL_ADMIN_PASSWORD=$JENKINS_PASSWORD" >> "$log_file"
else
  log_message "Waiting for Jenkins to create initial password file..."
  sleep 30
  if [ -f /var/lib/jenkins_home/secrets/initialAdminPassword ]; then
    JENKINS_PASSWORD=$(cat /var/lib/jenkins_home/secrets/initialAdminPassword)
    log_message "Jenkins initial admin password retrieved"
    echo "JENKINS_INITIAL_ADMIN_PASSWORD=$JENKINS_PASSWORD" >> "$log_file"
  fi
fi

# Install additional tools
log_message "Installing Git..."
apt-get install -y git || log_message "WARNING: Failed to install Git"

log_message "Installing Terraform..."
apt-get install -y curl gpg lsb-release
curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/hashicorp.list
apt-get update
apt-get install -y terraform || log_message "WARNING: Failed to install Terraform"

log_message "Installing AWS CLI..."
curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
unzip -q awscliv2.zip
./aws/install || log_message "WARNING: Failed to install AWS CLI"

log_message "Installing Maven..."
apt-get install -y maven || log_message "WARNING: Failed to install Maven"

log_message "Jenkins Docker installation completed successfully!"
log_message "Jenkins is accessible at http://$(hostname -I | awk '{print $1}'):8080"
log_message "Initial admin password: cat /var/lib/jenkins_home/secrets/initialAdminPassword"
